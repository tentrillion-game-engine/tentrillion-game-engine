[submodule "glfw"]
	path = libs/glfw
	url = https://github.com/glfw/glfw.git
[submodule "json"]
	path = libs/json
	url = https://github.com/nlohmann/json.git
[submodule "vulkan/libs/Vulkan-Headers"]
	path = vulkan/libs/Vulkan-Headers
	url = https://github.com/KhronosGroup/Vulkan-Headers.git
[submodule "vulkan/libs/volk"]
	path = vulkan/libs/volk
	url = https://github.com/zeux/volk.git
[submodule "compat/libs/SDL-1.2"]
	path = compat/libs/SDL-1.2
	url = https://github.com/libsdl-org/SDL-1.2.git
